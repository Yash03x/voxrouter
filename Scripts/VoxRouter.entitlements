<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Required once the hardened runtime is enabled, which notarization demands.
    Without it the app is signed and notarized but silently captures silence:
    Info.plist's usage string governs the prompt, this entitlement governs
    whether audio actually flows.
  -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!--
    Not sandboxed on purpose. The whole job is to launch `claude` and `codex`
    and let them work on your files; App Sandbox would make that impossible.
  -->
</dict>
</plist>
